{
  "name": "@lyon/dsh-steer",
  "version": "0.1.0",
  "description": "Live status badge + non-interrupting in-flight guidance for DeepSeek Harness. · DSH 会话头实时状态徽标 + 运行中「侧边对话式指导」（不打断、小步边界被读；支持图片附件、插话历史与一键重发、中英双语）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "status",
    "steer",
    "guidance"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyonleeeee/dsh-steer.git"
  },
  "homepage": "https://github.com/lyonleeeee/dsh-steer#readme",
  "bugs": {
    "url": "https://github.com/lyonleeeee/dsh-steer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}